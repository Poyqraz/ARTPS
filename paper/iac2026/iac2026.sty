% iac2026.sty — informal IAC 2026 layout helper (NOT an official IAF class).
% Primary geometry oracle: paper/template/IAC 2026_manuscript_template (2).pdf
%   (PyMuPDF-measured US Letter Word/PDF template; NOT A4 2.25/3.35 cm minima).
% Guidelines: IAC 2026 Manuscript Guidelines (IAF PDF). Community IAC_style.cls = secondary only.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{iac2026}[2026/08/10 Informal IAC 2026 manuscript style]

\RequirePackage[
  letterpaper,
  left=0.98in,
  right=0.95in,
  top=0.99in,
  bottom=1.0in,
  headheight=22pt,
  headsep=17.5pt,
  footskip=0.47in
]{geometry}
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{amsmath}
\RequirePackage{newtxtext}
\RequirePackage{newtxmath}
\RequirePackage{microtype}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,fit}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{url}
\RequirePackage[numbers,sort&compress]{natbib}
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\RequirePackage{caption}
\RequirePackage{setspace}
\singlespacing
\RequirePackage{titlesec}
\RequirePackage{placeins}
\RequirePackage[hidelinks]{hyperref}

\hypersetup{
  pdftitle={ARTPS: Operationally Safe Target Prioritization via Depth-Enhanced Hybrid Anomaly Detection},
  pdfauthor={Poyraz Baydemir},
  pdfsubject={IAC 2026 manuscript},
  pdfkeywords={Mars rover, autonomous exploration, anomaly detection, relative depth, target prioritization, operational safety}
}

\pdfcompresslevel=9
\pdfobjcompresslevel=3

% OFFICIAL_TEMPLATE_MEASURED inter-column text gap ≈ 0.17–0.20 in
\setlength{\columnsep}{0.22in}
\captionsetup{font=small,labelfont=bf,skip=4pt}
\captionsetup[figure]{name=Fig.,format=hang,indention=-20pt}
\captionsetup[table]{format=hang,justification=raggedright,singlelinecheck=false,indention=-24pt}

\newcommand{\IACcongress}{77th International Astronautical Congress (IAC 2026), Antalya, T\"urkiye, 5--9 Oct 2026.}
\newcommand{\IACcopyright}{Copyright \textcopyright2026 by the International Astronautical Federation (IAF). All rights reserved.}
% Canonical paper code is set in main.tex via \renewcommand{\IACpapercode}{...}.
\newcommand{\IACpapercode}{}%
\newcommand{\IACcorresponding}{}%

\newcommand{\IACapplypagestyle}{%
  \fancyhf{}%
  \fancyhead[C]{%
    \parbox{\textwidth}{%
      \centering\fontsize{8}{9.5}\selectfont
      \IACcongress\\
      \IACcopyright
    }%
  }%
  % OFFICIAL_TEMPLATE_MEASURED footer span ≈ 5.58 in, centered on page
  \fancyfoot[C]{%
    \fontsize{10}{12}\selectfont
    \makebox[5.58in][s]{\IACpapercode\hfill Page~\thepage\ of~\pageref{LastPage}}%
  }%
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0pt}%
}

\pagestyle{fancy}
\IACapplypagestyle
% First page of \twocolumn[...] often uses plain; keep the same header/footer.
\fancypagestyle{plain}{\IACapplypagestyle}

\newcommand{\IACmaketitle}[5]{%
  \twocolumn[{%
    \vspace*{-\topskip}%
    \vspace*{0.05in}%
    \begin{center}
      {\normalsize\IACpapercode\par}
      \vspace{0.85em}
      {\normalsize\bfseries #1\par}
      \vspace{0.55em}
      {\normalsize\bfseries #2\par}
    \end{center}
    \vspace{0.25em}
    {\normalsize\itshape\noindent #3\par}
    \vspace{0.35em}
    {\normalsize\upshape\noindent\IACcorresponding\par}
    \vspace{0.55em}
    \begin{center}
      {\normalsize\bfseries Abstract\par}
    \end{center}
    \noindent #4\par
    \vspace{0.55em}
    \noindent\textbf{Keywords:} #5\par
    \vspace{1.0em}
  }]%
}

\setlength{\parskip}{0pt}
\setlength{\parindent}{12pt}
\titleformat{\section}{\normalsize\bfseries\raggedright}{\thesection.}{0.5em}{}
\titleformat{\subsection}{\normalsize\itshape\raggedright}{\thesubsection}{0.5em}{}
\titleformat{\subsubsection}{\normalsize\itshape\raggedright}{\thesubsubsection}{0.5em}{}
\titlespacing*{\section}{0pt}{15pt}{3pt}
\titlespacing*{\subsection}{0pt}{12pt}{2pt}
\titlespacing*{\subsubsection}{0pt}{12pt}{2pt}
