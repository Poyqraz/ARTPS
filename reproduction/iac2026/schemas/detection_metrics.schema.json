{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "detection_metrics.schema.json",
  "title": "IAC2026DetectionMetrics",
  "type": "object",
  "required": [
    "claim_ids",
    "evidence_class",
    "eligible_for_claim_closure",
    "task_level",
    "score_semantics",
    "test_sample_count",
    "positive_count",
    "negative_count",
    "auroc",
    "average_precision",
    "trapezoidal_pr_auc",
    "primary_pr_metric_name",
    "primary_pr_metric_value",
    "f1",
    "precision",
    "recall",
    "selected_threshold",
    "threshold_source",
    "confusion_matrix",
    "reproduction_status"
  ],
  "properties": {
    "claim_ids": { "type": "array", "items": { "type": "string" } },
    "evidence_class": {
      "type": "string",
      "enum": ["software_verification", "candidate_real_evidence"]
    },
    "eligible_for_claim_closure": { "type": "boolean" },
    "task_level": { "type": "string" },
    "score_semantics": { "type": "string" },
    "test_sample_count": { "type": "integer", "minimum": 0 },
    "positive_count": { "type": "integer", "minimum": 0 },
    "negative_count": { "type": "integer", "minimum": 0 },
    "auroc": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "average_precision": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "trapezoidal_pr_auc": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "primary_pr_metric_name": {
      "type": "string",
      "enum": ["average_precision", "trapezoidal_pr_auc", "UNKNOWN"]
    },
    "primary_pr_metric_value": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "f1": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "precision": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "recall": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "selected_threshold": { "type": ["number", "null"] },
    "threshold_source": { "type": "string" },
    "threshold_selection_split": { "type": ["string", "null"] },
    "threshold_selection_metric": { "type": ["string", "null"] },
    "threshold_tie_break": { "type": ["string", "null"] },
    "validation_metric_at_selected_threshold": { "type": ["number", "null"] },
    "confusion_matrix": {
      "type": "object",
      "required": ["tn", "fp", "fn", "tp"],
      "properties": {
        "tn": { "type": "integer", "minimum": 0 },
        "fp": { "type": "integer", "minimum": 0 },
        "fn": { "type": "integer", "minimum": 0 },
        "tp": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "bootstrap_ci": { "type": ["object", "null"] },
    "reproduction_status": { "type": "string" },
    "notes": { "type": "string" },
    "test_sample_ids": { "type": "array", "items": { "type": "string" } },
    "model_name": { "type": "string" },
    "model_version": { "type": "string" },
    "config_id": { "type": "string" },
    "pr_metric_method": { "type": "string" },
    "higher_score_means_more_anomalous": { "type": "boolean" }
  },
  "additionalProperties": false
}
