{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "timing_result.schema.json",
  "title": "IAC2026TimingSummary",
  "type": "object",
  "required": [
    "claim_ids",
    "evidence_class",
    "eligible_for_claim_closure",
    "input_source",
    "pipeline_id",
    "profile",
    "source_commit",
    "implementation_hash",
    "equivalence_test_status",
    "config_sha256",
    "git_head",
    "git_dirty",
    "input_resolution",
    "batch_size",
    "learned_depth_enabled",
    "autoencoder_enabled",
    "warmup_count",
    "timed_iteration_count",
    "mean_core_latency_s",
    "mean_total_latency_s",
    "headline_fps",
    "headline_metric_name",
    "stages"
  ],
  "properties": {
    "claim_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "evidence_class": {
      "type": "string",
      "enum": ["software_verification", "candidate_real_evidence"]
    },
    "eligible_for_claim_closure": { "type": "boolean", "const": false },
    "input_source": {
      "type": "string",
      "enum": ["synthetic", "manifest"]
    },
    "pipeline_id": { "type": "string", "minLength": 1 },
    "profile": {
      "type": "string",
      "enum": [
        "historical_exact",
        "historical_software_verification",
        "current_enhancement_historical_surrogate"
      ]
    },
    "source_commit": { "type": "string", "minLength": 1 },
    "implementation_hash": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "equivalence_test_status": {
      "type": "string",
      "enum": ["not_independently_verified", "regression_smoke"]
    },
    "input_manifest_sha256": { "type": ["string", "null"] },
    "input_file_count": { "type": "integer", "minimum": 0 },
    "ordered_input_set_sha256": { "type": ["string", "null"] },
    "config_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "git_head": { "type": "string", "minLength": 1 },
    "git_dirty": { "type": "boolean" },
    "input_resolution": { "type": "integer", "const": 256 },
    "batch_size": { "type": "integer", "const": 1 },
    "learned_depth_enabled": { "type": "boolean", "const": false },
    "autoencoder_enabled": { "type": "boolean", "const": false },
    "warmup_count": { "type": "integer", "minimum": 30 },
    "timed_iteration_count": { "type": "integer", "minimum": 300 },
    "frame_count": { "type": "integer", "minimum": 1 },
    "mean_core_latency_s": { "type": "number", "exclusiveMinimum": 0 },
    "mean_total_latency_s": { "type": "number", "exclusiveMinimum": 0 },
    "headline_fps": { "type": "number", "exclusiveMinimum": 0 },
    "headline_metric_name": {
      "type": "string",
      "enum": [
        "historical_exact_fps",
        "current_enhancement_historical_surrogate_fps"
      ]
    },
    "historical_exact_fps": { "type": ["number", "null"] },
    "current_pipeline_fps": { "type": ["number", "null"] },
    "stages": {
      "type": "object",
      "properties": {
        "frame_fetch": { "type": "number" },
        "resize_preprocess": { "type": "number" },
        "enhancement": { "type": "number" },
        "reconstruction_surrogate": { "type": "number" },
        "fallback_depth": { "type": "number" },
        "fusion_localization_combined": { "type": "number" },
        "core_processing": { "type": "number" },
        "total_pipeline": { "type": "number" }
      },
      "additionalProperties": false
    },
    "environment_extended": { "type": "object" },
    "notes": { "type": "string" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "input_source": { "const": "manifest" } },
        "required": ["input_source"]
      },
      "then": {
        "properties": {
          "input_manifest_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "ordered_input_set_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        }
      }
    }
  ]
}
