{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "timing_result.schema.json",
  "title": "IAC2026TimingSummary",
  "type": "object",
  "required": [
    "claim_ids",
    "evidence_class",
    "eligible_for_claim_closure",
    "input_source",
    "pipeline_id",
    "source_commit",
    "input_resolution",
    "batch_size",
    "learned_depth_enabled",
    "autoencoder_enabled",
    "warmup_count",
    "timed_iteration_count",
    "headline_fps",
    "headline_metric_name",
    "stages",
    "git_head",
    "git_dirty"
  ],
  "properties": {
    "claim_ids": { "type": "array", "items": { "type": "string" } },
    "evidence_class": {
      "type": "string",
      "enum": ["software_verification", "candidate_real_evidence"]
    },
    "eligible_for_claim_closure": { "type": "boolean" },
    "input_source": {
      "type": "string",
      "enum": ["synthetic", "manifest", "images_dir"]
    },
    "pipeline_id": { "type": "string" },
    "source_commit": { "type": "string" },
    "implementation_hash": { "type": "string" },
    "equivalence_test_status": { "type": "string" },
    "input_manifest_sha256": { "type": ["string", "null"] },
    "config_sha256": { "type": ["string", "null"] },
    "git_head": { "type": "string" },
    "git_dirty": { "type": "boolean" },
    "input_resolution": { "type": "integer", "const": 256 },
    "batch_size": { "type": "integer", "const": 1 },
    "learned_depth_enabled": { "type": "boolean" },
    "autoencoder_enabled": { "type": "boolean" },
    "warmup_count": { "type": "integer", "minimum": 30 },
    "timed_iteration_count": { "type": "integer", "minimum": 300 },
    "frame_count": { "type": "integer", "minimum": 1 },
    "mean_core_latency_s": { "type": "number", "exclusiveMinimum": 0 },
    "mean_total_latency_s": { "type": "number", "exclusiveMinimum": 0 },
    "headline_fps": { "type": "number", "exclusiveMinimum": 0 },
    "headline_metric_name": { "type": "string" },
    "historical_exact_fps": { "type": ["number", "null"] },
    "current_pipeline_fps": { "type": ["number", "null"] },
    "stages": { "type": "object" },
    "environment_extended": { "type": "object" },
    "notes": { "type": "string" },
    "profile": { "type": "string" }
  },
  "additionalProperties": true
}
