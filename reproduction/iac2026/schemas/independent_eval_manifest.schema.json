{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "independent_eval_manifest.schema.json",
  "title": "IAC2026IndependentEvalManifestRow",
  "type": "object",
  "required": [
    "sample_id",
    "mission",
    "instrument",
    "sol",
    "source_id",
    "source_url",
    "product_id",
    "sequence_id",
    "acquisition_timestamp",
    "relative_path",
    "sha256",
    "raw_sha256",
    "derived_sha256",
    "preprocessing_version",
    "split",
    "binary_label",
    "label_semantics",
    "label_source",
    "annotation_version",
    "annotator_count",
    "label_confidence",
    "adjudication_status",
    "inclusion_status",
    "exclusion_reason",
    "scene_group_id",
    "duplicate_group_id",
    "notes"
  ],
  "properties": {
    "sample_id": { "type": "string", "minLength": 1 },
    "mission": { "type": "string" },
    "instrument": { "type": "string" },
    "sol": { "type": ["string", "integer"] },
    "source_id": { "type": "string" },
    "source_url": { "type": "string" },
    "product_id": { "type": "string" },
    "sequence_id": { "type": "string" },
    "acquisition_timestamp": { "type": "string" },
    "relative_path": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$|^SYNTHETIC_[A-Za-z0-9_]+$" },
    "raw_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$|^SYNTHETIC_[A-Za-z0-9_]+$|^$" },
    "derived_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$|^SYNTHETIC_[A-Za-z0-9_]+$|^$" },
    "preprocessing_version": { "type": "string" },
    "split": { "type": "string", "enum": ["train", "validation", "test"] },
    "binary_label": { "type": "integer", "enum": [0, 1] },
    "label_semantics": { "type": "string", "const": "anomaly_binary" },
    "label_source": { "type": "string" },
    "annotation_version": { "type": "string" },
    "annotator_count": { "type": ["integer", "string"] },
    "label_confidence": { "type": "string" },
    "adjudication_status": {
      "type": "string",
      "enum": ["resolved", "unresolved", "pending", "excluded"]
    },
    "inclusion_status": {
      "type": "string",
      "enum": ["included", "excluded", "uncertain"]
    },
    "exclusion_reason": { "type": "string" },
    "scene_group_id": { "type": "string" },
    "duplicate_group_id": { "type": "string" },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
