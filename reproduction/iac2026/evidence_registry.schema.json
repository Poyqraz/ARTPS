{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence_registry.schema.json",
  "title": "IAC2026EvidenceRegistry",
  "type": "object",
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "run_id",
          "claim_ids",
          "evidence_class",
          "artifact_uri",
          "archive_sha256",
          "config_sha256",
          "manifest_sha256",
          "commit_sha",
          "author_verified",
          "verification_date",
          "notes",
          "protocol_id",
          "protocol_lock_sha256",
          "evaluation_purpose",
          "annotation_version"
        ],
        "properties": {
          "run_id": { "type": "string", "minLength": 1 },
          "claim_ids": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "evidence_class": {
            "type": "string",
            "enum": ["candidate_real_evidence"]
          },
          "artifact_uri": { "type": "string", "minLength": 1 },
          "archive_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "config_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "predictions_sha256": {
            "type": ["string", "null"],
            "pattern": "^([a-fA-F0-9]{64})?$"
          },
          "timing_raw_sha256": {
            "type": ["string", "null"],
            "pattern": "^([a-fA-F0-9]{64})?$"
          },
          "checkpoint_sha256": {
            "type": ["string", "null"],
            "pattern": "^([a-fA-F0-9]{64})?$"
          },
          "protocol_id": { "type": ["string", "null"] },
          "protocol_lock_sha256": {
            "type": ["string", "null"],
            "pattern": "^([a-fA-F0-9]{64})?$"
          },
          "evaluation_purpose": {
            "type": ["string", "null"],
            "enum": [
              "historical_claim_reproduction",
              "current_reproducible_evaluation",
              "software_verification",
              null
            ]
          },
          "annotation_version": { "type": ["string", "null"] },
          "image_score_aggregation": { "type": ["string", "null"] },
          "commit_sha": { "type": "string", "minLength": 7 },
          "author_verified": { "type": "boolean" },
          "verification_date": { "type": "string", "format": "date-time" },
          "notes": { "type": "string" }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "claim_ids": {
                  "contains": { "enum": ["C05", "C06"] }
                }
              }
            },
            "then": {
              "properties": {
                "predictions_sha256": {
                  "type": "string",
                  "pattern": "^[a-fA-F0-9]{64}$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "claim_ids": {
                  "contains": { "const": "C07" }
                }
              }
            },
            "then": {
              "properties": {
                "timing_raw_sha256": {
                  "type": "string",
                  "pattern": "^[a-fA-F0-9]{64}$"
                }
              }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
